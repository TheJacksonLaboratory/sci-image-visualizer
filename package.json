{
  "name": "@jax-data-science/sci-image-visualizer",
  "version": "0.22.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Browser-based scientific image visualization for Angular — gigapixel whole-slide (OpenSeadragon), 2D/3D (Plotly) and WebGPU (napari-js) rendering, with region/annotation editing and in-browser SAM segmentation.",
  "keywords": [
    "angular",
    "image-visualization",
    "scientific-visualization",
    "openseadragon",
    "plotly",
    "napari",
    "webgpu",
    "whole-slide-imaging",
    "digital-pathology",
    "microscopy",
    "segmentation",
    "sam",
    "onnxruntime",
    "annotation",
    "region-editor"
  ],
  "author": "The Jackson Laboratory",
  "license": "MIT",
  "homepage": "https://github.com/TheJacksonLaboratory/sci-image-visualizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheJacksonLaboratory/sci-image-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/TheJacksonLaboratory/sci-image-visualizer/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json && npm run bundle-workers",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:server": "node --test examples/tile-server/test/*.test.mjs",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\" \"examples/tile-server/**/*.mjs\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"src/**/*.html\" \"examples/tile-server/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "bundle-workers": "node scripts/bundle-workers.mjs",
    "docs:serve": "mkdocs serve -f docs/user-guide/mkdocs.yml",
    "docs:build": "mkdocs build --strict -f docs/user-guide/mkdocs.yml",
    "docs:placeholders": "node scripts/docs-placeholders.mjs",
    "start:example": "vite --config examples/browser-image/vite.config.mts",
    "build:example": "vite build --config examples/browser-image/vite.config.mts",
    "prebuild:example": "node scripts/stage-lib.mjs",
    "prestart:example": "node scripts/stage-lib.mjs"
  },
  "dependencies": {
    "cellpose-js": "^0.6.0",
    "fast-png": "^6.4.0",
    "fzstd": "^0.1.1",
    "napari-js": "^0.20.0",
    "openseadragon": "^6.0.2",
    "plotly.js-dist-min": "^3.0.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/router": "^21.0.0",
    "buffer": "^5.7.1",
    "file-saver": "^2.0.5",
    "image-js": "^0.35.6",
    "onnxruntime-web": "~1.26.0",
    "primeflex": "^3.3.0 || ^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "primeflex": {
      "optional": true
    },
    "primeicons": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/animations": "^21.2.26",
    "@angular/build": "^21.2.30",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "@eslint/js": "^9.39.5",
    "@jax-js/jax": "^0.1.24",
    "@primeuix/themes": "^2.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "buffer": "^5.7.1",
    "dicom-parser": "^1.8.21",
    "esbuild": "^0.20.1",
    "eslint": "^9.39.5",
    "file-saver": "^2.0.5",
    "globals": "^16.5.0",
    "image-js": "^0.35.6",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^16.2.0",
    "ng-mocks": "^14.5.0",
    "ng-packagr": "^21.2.7",
    "onnxruntime-web": "~1.26.0",
    "playwright": "^1.61.1",
    "prettier": "^3.3.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.7",
    "zone.js": "~0.16.3"
  }
}
