{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "./dist",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    "src/lib/assets",
    "src/lib/styles",
    {
      "glob": "**/*",
      "input": "docs/user-guide",
      "output": "docs/user-guide",
      "ignore": ["site/**", "screenshots.json"]
    }
  ],
  "allowedNonPeerDependencies": [
    "cellpose-js",
    "fast-png",
    "fzstd",
    "napari-js",
    "openseadragon",
    "plotly.js-dist-min"
  ]
}
