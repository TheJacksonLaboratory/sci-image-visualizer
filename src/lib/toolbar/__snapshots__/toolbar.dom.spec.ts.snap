  "button:pi pi-trash "Delete selected region (<kbd>Del</kbd>)"",
  "|",
  "button:sam-box-prompt.svg "Segment the drawn rectangles with SAM (box prompt)"",
  "button:sam-point-prompt.svg "SAM point prompts: click a fiber to segment it as a new region; Shift/Alt-click to refine (exclude) the current one.<br>Esc undoes it."",
  "menu",
  "button:cells.svg "Auto-segment cells inside each drawn rectangle (cellpose-SAM)"",
  "|",
  "button:pi pi-question-circle "Help"",
]
`;

